<Window x:Class="ClaudeTaskBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeTaskBoard"
        Title="Claude Task Board"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- Width steps; cards live in a template, so they read the board's state through the window. -->
        <Style x:Key="HideWhenSlim" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Slim, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideWhenTiny" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Tiny, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Header buttons shrink at the narrowest width so that all of them still fit on one row. -->
        <Style x:Key="HeaderButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tiny}" Value="True">
                    <Setter Property="Width" Value="18" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource CardHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Padding="12,3" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Resize handles on the window's edges and corners. -->
        <Style x:Key="Grip" TargetType="Border">
            <Setter Property="Background" Value="#01000000" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Grip_MouseDown" />
            <EventSetter Event="MouseMove" Handler="Grip_MouseMove" />
            <EventSetter Event="MouseLeftButtonUp" Handler="Grip_MouseUp" />
        </Style>
        <Style x:Key="GripBar" TargetType="Border">
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Geometry x:Key="ColumnsIcon">M1.5,2 H10.5 V10 H1.5 Z M4.5,2 V10 M7.5,2 V10</Geometry>
        <Geometry x:Key="TileIcon">M1.5,2 H10.5 V10 H1.5 Z M6,2 V10 M1.5,6 H10.5</Geometry>

        <!-- Arrange buttons: color tells the group (working / waiting), the glyph the layout, the hint both.
             They narrow so that the whole row still fits at the board's minimum width. -->
        <Style x:Key="ArrangeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Height" Value="22" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.Placement" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tiny}" Value="True">
                    <Setter Property="Width" Value="15" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArrangeWorking" TargetType="Button" BasedOn="{StaticResource ArrangeButton}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style x:Key="ArrangeWaiting" TargetType="Button" BasedOn="{StaticResource ArrangeButton}">
            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
        </Style>

        <!-- Status dot; pulses while the session is working. -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{Binding StateBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                 Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One task-list step: check / running / pending icon + text. -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type local:StepVM}">
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left">
                    <Ellipse Fill="{DynamicResource Done}" Visibility="{Binding IsDone, Converter={StaticResource Vis}}" />
                    <Path Data="M3.2,6.2 L5.2,8.2 L8.8,4" Stroke="#FFFFFF" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Visibility="{Binding IsDone, Converter={StaticResource Vis}}" />
                    <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                             Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                    <Ellipse Fill="{DynamicResource Accent}" Width="5" Height="5"
                             Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                    <Ellipse Stroke="{DynamicResource FgSub}" StrokeThickness="1.2" Opacity="0.7"
                             Visibility="{Binding IsPending, Converter={StaticResource Vis}}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FgSub}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Session card. -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type local:SessionVM}">
            <!-- Wrapper owns the enter/exit animation so it doesn't fight the card's resting dim. -->
            <Border local:Anim.Show="{Binding IsPresent}" Visibility="Collapsed">
            <Border x:Name="CardBd" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                    Background="{DynamicResource Card}" MouseLeftButtonUp="Card_Click">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Puts the card away (duplicates, sessions not worth watching) until the session does something new. -->
                        <Button x:Name="DismissBtn" Grid.Column="4" Style="{StaticResource IconButton}" Width="18" Height="18"
                                Margin="2,-2,-5,-2" Opacity="0.45" Click="Dismiss_Click" VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="250" ToolTip="このカードを非表示（新しい動きがあれば再表示）">
                            <Path Style="{StaticResource IconPath}" Data="M3.5,3.5 L8.5,8.5 M8.5,3.5 L3.5,8.5" />
                        </Button>
                        <!-- Expand/collapse lives on the chevron; a click elsewhere on the card opens the session's window. -->
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="4,-3,0,-3"
                                Click="Chevron_Click" Visibility="{Binding ShowChevron, Converter={StaticResource Vis}}">
                            <Path Style="{StaticResource IconPath}" Data="M2.5,4.5 L6,8 L9.5,4.5" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ChevronRot" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <Ellipse Style="{StaticResource Dot}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Window mark: this session is open in its own desktop-app window. -->
                            <Border DockPanel.Dock="Left" Style="{StaticResource HideWhenTiny}">
                                <Path Data="M1.5,2.5 H10.5 V9.5 H1.5 Z M1.5,4.6 H10.5" Width="12" Height="12"
                                      Stroke="{DynamicResource FgSub}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Margin="0,0,5,0" VerticalAlignment="Center"
                                      Visibility="{Binding InWindow, Converter={StaticResource Vis}}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource HideWhenTiny}">
                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource FgSub}"
                                       Margin="0,0,8,0" Visibility="{Binding ShowCompactProgress, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StateBrush}" />
                            <Border Style="{StaticResource HideWhenSlim}">
                                <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource FgSub}" Margin="6,0,0,0" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Project}" FontSize="10.5" Foreground="{DynamicResource FgSub}"
                               Margin="16,1,0,0" TextTrimming="CharacterEllipsis"
                               local:Anim.Show="{Binding ShowProject}" Visibility="Collapsed" />

                    <!-- What Claude Code is asking (permission / question / plan / end-of-turn decision) or telling. -->
                    <Grid Margin="16,6,0,0" local:Anim.Show="{Binding ShowNotice}" Visibility="Collapsed">
                        <Border Background="{Binding NoticeBrush}" Opacity="0.14" CornerRadius="6" />
                        <Border Background="{Binding NoticeBrush}" Width="3" HorizontalAlignment="Left" CornerRadius="6,0,0,6" />
                        <Grid Margin="10,5,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left">
                                <Path Data="M6,0.8 A5.2,5.2 0 1 1 5.99,0.8 Z M6,3.4 V6.6 M6,8.7 V8.8" Stroke="{Binding NoticeBrush}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding NoticeNeedsAction, Converter={StaticResource Vis}}" />
                                <Path Data="M3,8.6 V5.6 A3,3 0 0 1 9,5.6 V8.6 L10,9.6 H2 Z M5,11 H7" Stroke="{Binding NoticeBrush}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoticeNeedsAction}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding NoticeTitle}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource InfoText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoticeNeedsAction}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding NoticeText}" FontSize="11.5" Margin="0,1,0,0" MaxHeight="48">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Compact}" Value="True">
                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="16,7,0,0" local:Anim.Show="{Binding ShowPlan}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{Binding ProgressBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11"
                                   Foreground="{DynamicResource FgSub}" Margin="8,0,0,0" />
                    </Grid>

                    <Grid Margin="16,5,0,0" local:Anim.Show="{Binding ShowCurrentStep}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M1,0.5 L7,4 L1,7.5 Z" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentStep}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ItemsControl Margin="16,5,0,0" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"
                                  local:Anim.Show="{Binding ShowSteps}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardBd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource CardHover}" />
                    <Setter TargetName="DismissBtn" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsResting}" Value="True">
                    <Setter TargetName="CardBd" Property="Opacity" Value="0.72" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChevronRot" Storyboard.TargetProperty="Angle"
                                                 To="180" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChevronRot" Storyboard.TargetProperty="Angle"
                                                 To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <!-- Outer margin leaves room for the drop shadow. -->
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <!-- Rows, not a stack: with a dragged height the card list takes whatever is left. -->
        <Grid Margin="10,8,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Header: drag handle + controls. -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Path Data="M7,0.5 V3.5 M7,10.5 V13.5 M0.5,7 H3.5 M10.5,7 H13.5 M2.4,2.4 L4.5,4.5 M9.5,9.5 L11.6,11.6 M2.4,11.6 L4.5,9.5 M9.5,4.5 L11.6,2.4"
                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="14" Height="14" VerticalAlignment="Center" Margin="2,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Claude タスク" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="10.5" Foreground="{DynamicResource FgSub}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.Column" Value="2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Slim}" Value="True">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Header-only view: everything below the header is put away. -->
                    <ToggleButton x:Name="CollapseBtn" Style="{StaticResource HeaderButton}" Click="Collapse_Click">
                        <Path Data="M2.5,7.5 L6,4 L9.5,7.5" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeaderOnly}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                    <ToggleButton x:Name="CompactBtn" Style="{StaticResource HeaderButton}" Click="Compact_Click">
                        <Path Style="{StaticResource IconPath}" Data="M1.5,3.5 H10.5 M1.5,6 H10.5 M1.5,8.5 H10.5" />
                    </ToggleButton>
                    <ToggleButton x:Name="PinBtn" Style="{StaticResource HeaderButton}" Click="Pin_Click">
                        <Path Style="{StaticResource IconPath}" Data="M4,1.5 H8 M5,1.5 V5 L3,7.5 H9 L7,5 V1.5 M6,7.5 V11" />
                    </ToggleButton>
                    <ToggleButton x:Name="SettingsBtn" Style="{StaticResource HeaderButton}"
                                  IsChecked="{Binding ShowSettings}">
                        <Path Style="{StaticResource IconPath}" Data="M1.5,3.5 H10.5 M1.5,8.5 H10.5 M4,2 V5 M8,7 V10" />
                    </ToggleButton>
                    <Button Style="{StaticResource HeaderButton}" Click="Close_Click">
                        <Path Style="{StaticResource IconPath}" Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Exit confirmation (✕ and Alt+F4), inline instead of a system dialog.
                 Outside the body: it must stay reachable in the header-only view. -->
            <Border Grid.Row="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource Card}"
                    local:Anim.Show="{Binding ConfirmExit}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ボードを終了しますか？" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="再開はデスクトップのショートカットから" FontSize="10.5" Foreground="{DynamicResource FgSub}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Grid.Column" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Slim}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <Button Style="{StaticResource TextButton}" Content="キャンセル" Click="CancelExit_Click" />
                        <Button Style="{StaticResource TextButton}" Content="終了" Click="ConfirmExit_Click"
                                Background="{DynamicResource Accent}" Foreground="#FFFFFF" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Everything the header-only view puts away. -->
            <Grid Grid.Row="2" local:Anim.Show="{Binding ShowBody}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The plan's weekly limit: used / remaining, as the official percentage. -->
                <Border CornerRadius="8" Padding="9,6" Margin="0,0,0,6" Background="{DynamicResource Bg}"
                        BorderBrush="{DynamicResource Card}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HideWhenTiny}">
                                <TextBlock Text="今週の使用量" FontSize="11" Foreground="{DynamicResource FgSub}" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="11.5" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Bar}" Margin="0,5,0,0" Value="{Binding UsageFraction, Mode=OneWay}"
                                     Foreground="{Binding UsageBrush}"
                                     Visibility="{Binding HasUsage, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding UsageDetail}" FontSize="10.5" Foreground="{DynamicResource FgSub}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Button Style="{StaticResource TextButton}" Content="CLIで再ログインコマンドを送信" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Click="CliLogin_Click"
                                Visibility="{Binding ShowLogin, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <!-- Inline settings panel (no popup). -->
                <Border Grid.Row="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource Card}"
                        local:Anim.Show="{Binding ShowSettings}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <!-- At the narrowest width the slider takes a row of its own. -->
                            <Slider x:Name="OpacitySlider"
                                    Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="Opacity_Changed">
                                <Slider.Style>
                                    <Style TargetType="Slider" BasedOn="{StaticResource FlatSlider}">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tiny}" Value="True">
                                                <Setter Property="Grid.Row" Value="1" />
                                                <Setter Property="Grid.Column" Value="0" />
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>
                            <Border Grid.Column="2" Style="{StaticResource HideWhenTiny}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource FgSub}" MinWidth="40"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" />
                            </Border>
                        </Grid>
                        <CheckBox x:Name="HideRestingBox" Style="{StaticResource Switch}" Margin="0,0,0,8" Click="HideResting_Click">
                            <TextBlock Text="完了・待機中のセッションを隠す" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" Click="Autostart_Click">
                            <TextBlock Text="Windows ログイン時に起動" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="動作中のセッションはありません" Foreground="{DynamicResource FgSub}" FontSize="11.5"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,12"
                           local:Anim.Show="{Binding IsEmpty}" Visibility="Collapsed" />

                <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- As many columns as the width allows: a row of cards when wide and short, a grid when large. -->
                    <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:TilePanel MinItemWidth="280" ColumnGap="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom edge: arranging session windows, always at hand. -->
                <DockPanel Grid.Row="4" Margin="0,2,0,0">
                    <!-- The switch template keeps 10 for a label; there is none here. -->
                    <CheckBox x:Name="ArrangeRightBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="-10,0,0,0"
                              VerticalAlignment="Center" Click="ArrangeRight_Click"
                              ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Top"
                              ToolTip="整列時の寄せ方（オンで右寄せ、オフで左寄せ）" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ArrangeWorking}" Click="ArrangeWorkingColumns_Click"
                                ToolTip="進行中のもののみ縦列で整列（再度押すと左端を右端へ送る）">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource ColumnsIcon}" />
                        </Button>
                        <Button Style="{StaticResource ArrangeWorking}" Click="ArrangeWorkingTile_Click"
                                ToolTip="進行中のもののみタイルで整列（再度押すと左上を右下へ送る）">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource TileIcon}" />
                        </Button>
                        <Border Width="6" Style="{StaticResource HideWhenSlim}" />
                        <Button Style="{StaticResource ArrangeWaiting}" Click="ArrangeWaitingColumns_Click"
                                ToolTip="判断が必要なもののみ縦列で整列（再度押すと左端を右端へ送る）">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource ColumnsIcon}" />
                        </Button>
                        <Button Style="{StaticResource ArrangeWaiting}" Click="ArrangeWaitingTile_Click"
                                ToolTip="判断が必要なもののみタイルで整列（再度押すと左上を右下へ送る）">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource TileIcon}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- In-window toast (no system popups). -->
            <Border Grid.Row="3" CornerRadius="6" Padding="10,6" Margin="0,2,0,2" Background="{DynamicResource CardHover}"
                    local:Anim.Show="{Binding ShowToast}" Visibility="Collapsed">
                <TextBlock Text="{Binding ToastText}" FontSize="11" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>

    <!-- Edges and corners: hover shows the handle, dragging resizes from that side (Tag = the sides it moves).
         Double-clicking the top or bottom edge goes back to fitting the content. The nearly transparent fill
         makes the part outside the panel hit-testable in this layered window. -->
    <Border Style="{StaticResource Grip}" Tag="R" Width="10" HorizontalAlignment="Right" Margin="0,24,7,24" Cursor="SizeWE">
        <Border Style="{StaticResource GripBar}" Width="3" HorizontalAlignment="Center" />
    </Border>
    <Border Style="{StaticResource Grip}" Tag="L" Width="10" HorizontalAlignment="Left" Margin="7,24,0,24" Cursor="SizeWE">
        <Border Style="{StaticResource GripBar}" Width="3" HorizontalAlignment="Center" />
    </Border>
    <Border Style="{StaticResource Grip}" Tag="T" Height="10" VerticalAlignment="Top" Margin="24,7,24,0" Cursor="SizeNS">
        <Border Style="{StaticResource GripBar}" Height="3" VerticalAlignment="Center" />
    </Border>
    <Border Style="{StaticResource Grip}" Tag="B" Height="10" VerticalAlignment="Bottom" Margin="24,0,24,7" Cursor="SizeNS">
        <Border Style="{StaticResource GripBar}" Height="3" VerticalAlignment="Center" />
    </Border>
    <Border Style="{StaticResource Grip}" Tag="TL" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0" Cursor="SizeNWSE" />
    <Border Style="{StaticResource Grip}" Tag="TR" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" Cursor="SizeNESW" />
    <Border Style="{StaticResource Grip}" Tag="BL" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,7" Cursor="SizeNESW" />
    <Border Style="{StaticResource Grip}" Tag="BR" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7" Cursor="SizeNWSE" />
    </Grid>
</Window>
